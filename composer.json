{
    "name": "taw/gutenberg",
    "description": "TAW Gutenberg — the TAW block (FSE) theme; its data layer comes from taw/core",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Marco Del Riego",
            "email": "marck94zac1@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "taw/core": "^1.50"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Relmaur/taw-core"
        }
    ],
    "autoload": {
        "psr-4": {
            "TAW\\Gutenberg\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TAW\\Gutenberg\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": [
            "npm install --no-audit --no-fund",
            "npm run build"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "schema:validate": "php bin/taw schema:validate"
    }
}
